<root BTCPP_format="4" main_tree_to_execute="Main">
  <BehaviorTree ID="Main">
    <Sequence>
      <Capability_perception_detect_tomato node_id="observe" role="vision" out_target="{observed}"/>
      <SubTree ID="CheckTarget" target="{observed}"/>
      <TargetsFromPose target="{observed}" targets="{targets}"/>
      <SelectTarget targets="{targets}" index="json:{&quot;value&quot;:0,&quot;unit&quot;:&quot;1&quot;}" target="{selected}"/>
      <Fallback>
        <AlwaysFailure/>
        <HasTarget target="{selected}"/>
      </Fallback>
    </Sequence>
  </BehaviorTree>
  <BehaviorTree ID="CheckTarget">
    <HasTarget target="{target}"/>
  </BehaviorTree>
</root>
